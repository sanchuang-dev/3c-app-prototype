{
  "manifest_version": 2,
  "name": "3C Prototype Native Bridge",
  "version": "1.0.0",
  "description": "Origin-scoped GeckoView native messaging",
  "browser_specific_settings": {
    "gecko": {
      "id": "threecbridge@3cgroup.cn"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lab.3cgroup.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": false,
      "run_at": "document_start"
    }
  ]
}
